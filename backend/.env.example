NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
FRONTEND_URL=https://pluten.site
PUBLIC_SITE_URL=https://pluten.site
CORS_ORIGINS=https://pluten.site,https://www.pluten.site
AUTH_COOKIE_DOMAIN=.pluten.site
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=60
GOOGLE_CLIENT_ID=your-google-client-id
CASHFREE_MODE=production
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_URL=https://YOUR-API/api/v1/payments/webhook
CLOUD_REGION=your-region
CLOUD_ENDPOINT=https://your-s3-compatible-endpoint
CLOUD_BUCKET_NAME=your-private-bucket
CLOUD_ACCESS_KEY=your-access-key
CLOUD_SECRET_KEY=your-secret-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_THUMBNAIL_FOLDER=pluten/products
FRONTEND_REVALIDATION_URL=https://pluten.site/api/revalidate
FRONTEND_REVALIDATION_SECRET=replace-me
JSON_BODY_LIMIT=1mb
